<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 27+: çentik/punch-hole bölgesine çizmeye izin.
         `windowLayoutInDisplayCutoutMode` yalnız 27+ bir tema niteliğidir, bu
         yüzden `values/styles.xml` içindeki temel sürümde DURMAZ (minSdk 23).
         Yatayda çentik sol/sağ kenardadır; `shortEdges` olmadan WebView çentiğin
         arkasına çizemez ve `env(safe-area-inset-left/right)` hep 0 kalır —
         playfield o payı tam da buradan okuyor (src/core/playfield.js).

         Kural: `values/styles.xml` değişirse BU dosya da aynı stile ek olarak
         değişmelidir; iki kopya sessizce ayrışır. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
