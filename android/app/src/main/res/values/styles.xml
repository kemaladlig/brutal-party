<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Açılış teması. `android:background` splash'ı çizen şeydir (Capacitor
         `setSplashScreen` çağırmaz, sistem/kitlik bunu tema üzerinden çizer);
         `windowSplashScreen*` nitelikleri Android 12+'ta SYSTEM splash'ı
         besler — orada varsayılan zemin beyazdır, yani bunlarsız 12+ cihazda
         beyaz flaş geri gelir. Simge olarak markalı "4P" launcher rozeti.
         `postSplashScreenTheme` BİLİNÇLİ yok: `AppTheme.NoActionBar` pencere
         zeminini `@null` yapıyor ve splash→WebView arasında boşluk görünürdü.

         DİKKAT: `values-v27/styles.xml` bu stili yeniden yazar (kaynak
         nitelendirme kuralı: override tüm stili değiştirir). Buraya eklenen
         her öğe oraya da eklenmelidir. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/brand_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>