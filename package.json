{
  "name": "brutal-party-4p",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node server/index.js",
    "dev:https": "vite --host 0.0.0.0 --port 3000 --mode https",
    "dev:share": "node scripts/share.mjs",
    "build": "vite build",
    "check": "tsc --noEmit && npm run check:undef && npm run check:tokens && npm run check:rules && npm run test && npm run health",
    "typecheck": "node scripts/typecheck.mjs --stats",
    "typecheck:gate": "node scripts/typecheck.mjs",
    "check:undef": "node scripts/undef-lint.mjs",
    "check:tokens": "node scripts/token-lint.mjs",
    "check:rules": "node scripts/rules-lint.mjs",
    "lint": "tsc --noEmit && npm run check:undef && npm run check:tokens",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "health": "node scripts/health.mjs",
    "build:android": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "localtunnel": "^2.0.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@supabase/supabase-js": "^2.116.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  }
}
