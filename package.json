{
  "name": "brutal-party-4p",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node server/index.js",
    "dev:https": "vite --host 0.0.0.0 --port 3000 --mode https",
    "dev:share": "node scripts/share.mjs",
    "build": "vite build",
    "icons": "node scripts/generate-icons.mjs",
    "build:android": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "localtunnel": "^2.0.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.23.0",
    "@supabase/supabase-js": "^2.116.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  }
}
